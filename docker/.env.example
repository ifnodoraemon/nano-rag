# docker/.env —— 只需要你填「外部凭据」。
#
# 最快的方式（自动生成密钥，不用手写 openssl）：
#     python scripts/init_env.py          # 生成 docker/.env
#     python scripts/init_env.py --check  # 检查还缺什么
#
# 本文件是等价的手写模板。docker/.env 已被 .gitignore 忽略，绝不要提交。
#
# ──────────────────────────────────────────────────────────────────────
# 只有 2 项需要你提供；其余全部自动生成或从别处派生。
# ──────────────────────────────────────────────────────────────────────

# ============ 1. 外部凭据（唯一需要你填的部分） ============

# 生成模型：对话、阅读计划、证据审计、图抽取都走它。
# 支持 Gemini 直连，或 Qwen / DashScope / 任意 OpenAI 兼容端点。
GENERATION_API_KEY=
GENERATION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GENERATION_MODEL_ALIAS=gemini-flash-latest

# 文档解析模型：只在摄入 PDF / 图片 / Office 文件时需要；纯 md/txt 可以留空。
DOCUMENT_PARSER_PROVIDER=gemini
DOCUMENT_PARSER_API_KEY=
DOCUMENT_PARSER_API_BASE_URL=https://generativelanguage.googleapis.com
DOCUMENT_PARSER_MODEL=gemini-flash-latest

# ============ 2. 自动生成的密钥（由 init_env.py 写入，无需手填） ============
# 若你手写此文件，用 openssl rand -hex 32 生成，并保证两者不同：
#   RAG_API_KEYS       业务密钥（浏览器不需要它，nginx 为业务路由注入）
#   RAG_ADMIN_API_KEYS 运维密钥（注入/追踪/评测/回放/health/detail）
#   POSTGRES_PASSWORD  内部数据库密码（服务未对外发布）
#
# RAG_PROXY_API_KEY 不再需要：它默认取 RAG_API_KEYS。

RAG_API_KEYS=
RAG_ADMIN_API_KEYS=
POSTGRES_PASSWORD=

# ============ 3. 运行环境 ============
# local：允许弱默认密钥（仅开发）。prod：拒绝已知弱密钥。
RAG_ENV=local

# ============ 4. 可选 ============
# 前端监听地址：默认只绑本机。改成 0.0.0.0 之前，请确认前面有鉴权代理，
# 因为该端口会注入业务密钥（凡能访问它的人都等同业务调用者）。
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3001


# Celery worker 并发（摄入并行度）
RAG_WORKER_CONCURRENCY=32

# ============ 已废弃（保留兼容，不再是必需项） ============
# COMPOSE_* 前缀名、MODEL_GATEWAY_*、PG_PASSWORD、RAG_WIKI_ENABLED、
# MODEL_GATEWAY_MODE 仍会被识别，但不需要配置：
#   - GENERATION_* 是唯一的 provider 来源，MODEL_GATEWAY_* 只是历史别名；
#   - PG_URI 由 POSTGRES_USER/PASSWORD/DB 派生，不单独配置；
#   - RAG_WIKI_ENABLED 必须为 true（false 会让启动失败），因此无需配置；
#   - MODEL_GATEWAY_MODE 只支持 live（mock 已被拒绝），因此无需配置。
