# Copy to docker/.env and fill in. docker/.env is git-ignored (never commit it).
#
#   cp docker/.env.example docker/.env
#   openssl rand -hex 32   # run twice, once per key
#
# Required: compose refuses to start without these three.
RAG_API_KEYS=
RAG_ADMIN_API_KEYS=
RAG_PROXY_API_KEY=

# local/dev/test tolerates known-insecure keys (development only);
# anything else (the default) rejects them.
# RAG_ENV=local

# Public bind address for the SPA. Loopback by default — the nginx proxy
# injects a business key, so only expose it behind your own authenticating proxy.
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=3001

# Generation provider (Gemini direct, or Qwen/DashScope/OpenAI-compatible).
COMPOSE_GENERATION_API_KEY=
COMPOSE_GENERATION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
COMPOSE_GENERATION_MODEL_ALIAS=gemini-flash-latest

# Document parser (multimodal). Required when DOCUMENT_PARSER_ENABLED=true.
COMPOSE_DOCUMENT_PARSER_PROVIDER=gemini
COMPOSE_DOCUMENT_PARSER_API_KEY=
COMPOSE_DOCUMENT_PARSER_API_BASE_URL=https://generativelanguage.googleapis.com
COMPOSE_DOCUMENT_PARSER_MODEL=gemini-flash-latest

# Celery ingest fan-out.
RAG_WORKER_CONCURRENCY=32
